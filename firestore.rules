rules_version = '2';
// חוקי אבטחה ל-Firestore של Y&B CRAVE.
// מדביקים את הקובץ הזה ב-Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null; }

    // מוצרים: כולם קוראים. רק מנהל עורך.
    // לקוחות יכולים רק לעדכן מונים (מלאי שירד, נמכרו, "תודיעו לי").
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['qty', 'soldCount', 'weekSold', 'notifyCount']);
    }

    // הזמנות: כל אחד יכול ליצור ולצפות בהזמנה לפי המזהה שלה (מעקב). רק מנהל רואה רשימה ומעדכן.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.paid == false
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() < 80;
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    match /meta/settings {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meta/votes {
      allow read, write: if true;
    }
    match /meta/counter {
      allow read: if true;
      allow write: if request.resource.data.value is int;
    }
  }
}
